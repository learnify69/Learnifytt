            border: 1px solid rgba(37, 99, 235, 0.4);
            box-shadow: 0 10px 40px -10px rgba(37, 99, 235, 0.3);
            transform: translateY(-5px);
        }

        /* Scroll Animation Classes */
        .reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
        }
        .reveal.active {
            opacity: 1;
